# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret for Traveler, Planner, and Admin Authentication
JWT_SECRET=super_secure_trip_planner_jwt_secret_key_2026

# MySQL Database Configuration
# Set your local MySQL password below to connect to MySQL Server (e.g. MySQL80)
# If MySQL is not reachable or credentials are omitted, the server automatically
# operates with the built-in seeded storage engine.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tourist

# Payment Provider Configuration (Test / Development Mode)
# Leave as 'test' for simulated safe checkout. In production, provide real Stripe/Razorpay keys:
PAYMENT_GATEWAY_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
